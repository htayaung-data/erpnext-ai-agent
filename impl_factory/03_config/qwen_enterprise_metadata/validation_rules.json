{
  "contract_version": "1.1",
  "profiles": [
    {
      "profile_id": "report_grounded_read",
      "requires_successful_grounding_tool": true,
      "allowed_grounding_tools": [
        "erp_fac-generate_report",
        "erp_fac-get_document",
        "erp_fac-list_documents",
        "erp_fac-search_documents",
        "erp_fac-fetch"
      ],
      "requires_approved_report": true,
      "requires_required_filters": true,
      "requires_semantic_validation": true,
      "requires_field_presence_validation": true,
      "requires_time_scope_consistency": true,
      "zero_result_policy": "clarify_when_unexpected"
    },
    {
      "profile_id": "local_transform",
      "requires_grounded_parent": true
    }
  ],
  "semantic_validation": {
    "deterministic_order": [
      "schema_check",
      "field_presence_check",
      "semantic_tag_check",
      "time_scope_check",
      "dimension_metric_check"
    ],
    "inconclusive_policy": "clarify",
    "zero_result_clarify_intent_classes": [
      "ranked_entities",
      "trend_analysis",
      "product_performance"
    ]
  },
  "ambiguity_rules": [
    {
      "intent_class": "trend_analysis",
      "requires": [
        "requested_time_scope"
      ],
      "decision": "clarify"
    },
    {
      "intent_class": "ranked_entities",
      "requires_any": [
        "requested_metrics",
        "requested_dimensions"
      ],
      "decision": "clarify"
    },
    {
      "intent_class": "product_performance",
      "requires": [
        "requested_time_scope"
      ],
      "decision": "clarify"
    }
  ],
  "governed_scope_integrity": {
    "required_registry_files": [
      "governed_scope_registry.json",
      "scope_owner_registry.json",
      "family_scope_compatibility_registry.json",
      "scope_projection_registry.json",
      "scope_clarification_registry.json"
    ],
    "active_scope_requirements": [
      "owner_declared",
      "approved_source_authority_declared",
      "compatible_family_declared",
      "projection_policy_declared",
      "clarification_coverage_declared"
    ],
    "pair_integrity_requirements": [
      "no_unknown_scope_reference",
      "no_unknown_family_reference",
      "projection_requires_compatible_family",
      "clarification_requires_compatible_family"
    ],
    "support_state_rules": [
      "active_scope_cannot_use_pending_authority",
      "restricted_listing_scope_must_declare_blocked_listing_reason",
      "frontdoor_inactive_scope_must_not_be_marked_active"
    ]
  }
}
