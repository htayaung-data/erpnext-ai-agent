{
  "name": "erp-workspace-ui-smoke",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright smoke suite for PrimeAxis child-page runtime diagnostics",
  "scripts": {
    "test": "playwright test",
    "test:roles": "node role_permission_smoke.js",
    "test:sales-order-analysis": "node sales_order_analysis_smoke.js",
    "test:procurement-phase1": "node procurement_phase1_smoke.js",
    "test:procurement-phase2": "node procurement_phase2_smoke.js",
    "test:procurement-phase3": "node procurement_phase3_smoke.js",
    "test:docker": "bash ./run_playwright_docker.sh",
    "test:roles:docker": "bash ./run_playwright_docker.sh npm run test:roles",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "capture:references": "playwright test tests/reference_page_capture.spec.js",
    "capture:references:headed": "playwright test tests/reference_page_capture.spec.js --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1"
  }
}
