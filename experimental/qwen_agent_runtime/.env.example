APP_HOST=0.0.0.0
APP_PORT=8010
RUNTIME_API_TOKEN=
ENGINE_MODE=qwen_agent
CHAT_TIMEOUT_SECONDS=45
RESPONSE_CHAR_LIMIT=4000
MAX_TOOL_CALLS=4

QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus
QWEN_API_KEY=

FAC_MCP_URL=https://meet.erpbosai.com/api/method/frappe_assistant_core.api.fac_endpoint.handle_mcp
FAC_MCP_SERVER_NAME=erp_fac
FAC_MCP_TRANSPORT=streamable-http
FAC_ALLOWED_TOOLS=erp_fac-get_document,erp_fac-list_documents,erp_fac-search_documents,erp_fac-search_doctype,erp_fac-search_link,erp_fac-search,erp_fac-fetch,erp_fac-get_doctype_info,erp_fac-generate_report,erp_fac-report_list,erp_fac-report_requirements
FAC_AUTH_BEARER_TOKEN=
FAC_AUTH_HEADER_NAME=Authorization
FAC_AUTH_HEADER_VALUE=token your_api_key:your_api_secret
FAC_MCP_CONFIG_JSON=
